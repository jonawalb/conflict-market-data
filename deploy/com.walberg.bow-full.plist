<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.walberg.bow-full</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__COLLECTOR_DIR__/run_collect.sh</string>
    <string>full</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>15</integer></dict>
  </array>
  <key>RunAtLoad</key><false/>
  <key>StandardErrorPath</key><string>__DATA_DIR__/launchd-full.err</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
